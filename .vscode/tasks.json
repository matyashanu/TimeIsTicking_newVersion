{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-backend",
      "type": "shell",
      "command": "cd ${workspaceFolder}/timeticking/backend && npm run build",
      "problemMatcher": ["$tsc"],
      "isBackground": false
    },
    {
      "label": "start-backend-dev",
      "type": "shell",
      "command": "cd ${workspaceFolder}/timeticking/backend && npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*tsx watch.*",
          "endsPattern": "^.*ready on.*"
        }
      }
    },
    {
      "label": "start-frontend-dev",
      "type": "shell",
      "command": "cd ${workspaceFolder}/timeticking/frontend && npm run dev",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^.*$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*next dev.*",
          "endsPattern": "^.*ready on.*"
        }
      }
    },
    {
      "label": "start-both",
      "dependsOn": ["start-backend-dev", "start-frontend-dev"],
      "problemMatcher": [],
      "isBackground": true
    }
  ]
}
